{
  "project_name": "TestPilot-RL",
  "version": "1.0.0",
  "seed": 42,
  "simulator": {
    "num_test_cases": 30,
    "num_features": 12,
    "min_bugs_per_build": 5,
    "max_bugs_per_build": 10,
